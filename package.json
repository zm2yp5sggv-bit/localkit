{
  "name": "localkit",
  "version": "1.0.0",
  "private": true,
  "description": "20 个纯浏览器端工具——文件永不上传。注意：本 package.json 只服务于开发与测试，站点本身是零构建、零运行时依赖的静态页面，部署时不需要 npm。",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.mjs 4173",
    "lint": "eslint .",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:vendor": "node scripts/update-vendor.mjs --check",
    "check": "npm run check:i18n && npm run check:syntax && npm run check:deploy && npm run check:vendor",
    "test:checks": "node --test \"tests/node/**/*.test.mjs\"",
    "update:vendor": "node scripts/update-vendor.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "ci": "npm run lint && npm run check && npm run test:checks && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.47.2",
    "eslint": "^10.10.0",
    "globals": "^16.5.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
